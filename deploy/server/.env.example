# 复制到 <HOME>/.env（例如 /www/wwwroot/xiuxian/.env）后按需修改。
# 未写的项使用默认值（与 Cloudflare 生产配置一致）。

# 监听地址与端口：宝塔反向代理到 http://127.0.0.1:8787
HOST=127.0.0.1
PORT=8787

# 在宝塔 nginx 后面：用 X-Real-IP 作为玩家 IP（登录限频用）。直接对外暴露端口时改成 0。
TRUST_PROXY=1

# 数据库文件（相对 <HOME>）；备份保留份数
DB_PATH=data/xiuxian.db
BACKUP_KEEP=14

# 游戏配置
ENVIRONMENT=production
REGISTRATION_ENABLED=true
INVITE_CODES=
SESSION_TTL_SECONDS=604800
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
ALLOWED_ORIGINS=
REALM_EXPLORE_ENABLED=true

# 讨伐（世界 Boss）每个宗门每天最多出手几次，防协议脚本全天刷；0 = 不限。
# 改完执行 pm2 restart xiuxian 生效（不用重新部署）。
WORLD_BOSS_DAILY_ATTACK_LIMIT=120

# 论道赌局的 AI 胜率判定（不填则自动降级为规则判定）
OPENROUTER_API_KEY=
